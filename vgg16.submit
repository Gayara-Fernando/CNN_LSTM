#!/bin/bash
#SBATCH --job-name=VGG16_train
#SBATCH --ntasks=16
#SBATCH --mem=150g
#SBATCH --time=15:00:00
#SBATCH --error=VGG16.%J.err
#SBATCH --output=VGG16.%J.out
#SBATCH --partition=stats-gaann
#SBATCH --gres=gpu

module purge
module load anaconda
conda activate $COMMON/tfp_for_TN

python VGG16.py 