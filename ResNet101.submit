#!/bin/bash
#SBATCH --job-name=ResNet101_train
#SBATCH --ntasks=16
#SBATCH --mem=150g
#SBATCH --time=12:00:00
#SBATCH --error=ResNet101.%J.err
#SBATCH --output=ResNet101.%J.out
#SBATCH --partition=stats-gaann
#SBATCH --gres=gpu

module purge
module load anaconda
conda activate $COMMON/tfp_for_TN

python ResNet101.py 